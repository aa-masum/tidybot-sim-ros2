<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Robot-vacuum style cleaning robot: round, 34 cm diameter, 11.5 cm tall
       (incl. lidar turret). Fits under furniture with > 12 cm clearance. -->
  <model name="ugv">

    <link name="base_link">
      <pose>0 0 0.055 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0229</ixx><iyy>0.0229</iyy><izz>0.0434</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Body: cylinder r=0.17, z from 0.02 to 0.09 -->
      <collision name="body_col">
        <geometry><cylinder><radius>0.17</radius><length>0.07</length></cylinder></geometry>
      </collision>
      <visual name="body_lower">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.172</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
      <visual name="body_upper">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.93 0.93 0.95 1</ambient><diffuse>0.93 0.93 0.95 1</diffuse></material>
      </visual>
      <visual name="top_ring">
        <pose>0 0 0.0365 0 0 0</pose>
        <geometry><cylinder><radius>0.13</radius><length>0.003</length></cylinder></geometry>
        <material><ambient>0.2 0.55 0.85 1</ambient><diffuse>0.2 0.55 0.85 1</diffuse></material>
      </visual>
      <visual name="top_plate">
        <pose>0 0 0.0375 0 0 0</pose>
        <geometry><cylinder><radius>0.115</radius><length>0.003</length></cylinder></geometry>
        <material><ambient>0.96 0.96 0.97 1</ambient><diffuse>0.96 0.96 0.97 1</diffuse></material>
      </visual>
      <visual name="power_button">
        <pose>-0.07 0 0.0395 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.003</length></cylinder></geometry>
        <material><ambient>0.1 0.8 0.3 1</ambient><diffuse>0.1 0.8 0.3 1</diffuse></material>
      </visual>
      <visual name="front_bumper">
        <pose>0.158 0 0.0 0 0 0</pose>
        <geometry><box><size>0.02 0.2 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material>
      </visual>
      <visual name="side_brush">
        <pose>0.14 0.1 -0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material>
      </visual>

      <!-- Lidar turret (visual only) -->
      <visual name="lidar_turret">
        <pose>0 0 0.0475 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.05 0.05 0.06 1</diffuse></material>
      </visual>

      <!-- Casters -->
      <collision name="front_caster_col">
        <pose>0.12 0 -0.04 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <visual name="front_caster_vis">
        <pose>0.12 0 -0.04 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
      </visual>
      <collision name="rear_caster_col">
        <pose>-0.12 0 -0.04 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <visual name="rear_caster_vis">
        <pose>-0.12 0 -0.04 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
      </visual>

      <!-- Main 360 degree lidar (world height 0.105 m: sees legs, not table tops) -->
      <sensor name="lidar" type="ray">
        <pose>0 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range><min>0.08</min><max>8.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>

      <!-- Low forward bumper sensor (world height 0.035 m) -->
      <sensor name="low_lidar" type="ray">
        <pose>0.16 0 -0.02 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>21</samples>
              <resolution>1</resolution>
              <min_angle>-0.6</min_angle>
              <max_angle>0.6</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>1.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="low_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan_low</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>low_lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0 0.15 0.035 -1.5707 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000068</ixx><iyy>0.000068</iyy><izz>0.00012</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.15 0.035 -1.5707 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000068</ixx><iyy>0.000068</iyy><izz>0.00012</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.30</wheel_separation>
      <wheel_diameter>0.07</wheel_diameter>
      <max_wheel_torque>5</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>

  </model>
</sdf>
